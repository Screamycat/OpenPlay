{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPlay Setup",
  "version": "1.0.0",
  "identifier": "com.openplay.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenPlay Setup",
        "width": 760,
        "height": 540,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
