{
  "name": "openplay",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source, offline-first cross-platform game library and launcher",
  "homepage": "https://github.com/Screamycat/OpenPlay",
  "author": "ScreamyCat <screamys.cat@gmail.com>",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"npm run dev:vite\" \"npm run electron:dev\"",
    "dev:fast": "concurrently -k -s first \"npm run dev:vite\" \"npm run electron:dev-only\"",
    "dev:vite": "vite",
    "core:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin openplay-core",
    "electron:build": "tsc -p tsconfig.electron.json && node -e \"import('node:fs').then(fs=>fs.writeFileSync('dist-electron/package.json','{\\\"type\\\":\\\"commonjs\\\"}'))\"",
    "electron:dev": "npm run core:build && npm run electron:build && electron dist-electron/main.js --no-sandbox",
    "electron:dev-only": "npm run electron:build && electron dist-electron/main.js --no-sandbox",
    "electron:start": "npm run core:build && electron dist-electron/main.js --no-sandbox",
    "build": "tsc && vite build && npm run electron:build",
    "build:all": "npm run core:build && npm run build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "howlongtobeat": "^1.8.0",
    "lucide-react": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
